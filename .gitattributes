# ── Normalizzazione line endings ─────────────────────────────
# * text=auto: Git converte in LF in repo, rispetta il sistema a checkout
* text=auto

# Script shell e wrapper Gradle devono restare LF anche su Windows
*.sh text eol=lf
gradlew text eol=lf

# File binari da non toccare
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.keystore binary
*.jks binary
